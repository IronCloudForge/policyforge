        "mandatory": true,
    },
    {
        "id": "dr4040_430-req-052",
        "section": "5",
        "section_title": "Performance Management",
        "text": "90 consecutive or non-consecutive days, an interim rating must be produced when: a A performance plan is revised 90 or more days before the end of the performance year; b The employee is reassigned or promoted 90 or more days before the end of the performance year;",
