        "keyword": "must",
        "mandatory": true,
    },
    {
        "id": "dr4040_430-req-043",
        "section": "5",
        "section_title": "Performance Management",
        "text": "c If this discussion cannot take place, the Rating Official must document the reason for not having the employee’s signature on the form.",
        "keyword": "must",
        "mandatory": true,
    },
    {
        "id": "dr4040_430-req-044",
        "section": "5",
        "section_title": "Performance Management",
        "text": "The Rating Official must document the reason for not having the employee’s signature on the form.",
        "keyword": "must",
        "mandatory": true,
    },
    {
        "id": "dr4040_430-req-045",
        "section": "5",
        "section_title": "Performance Management",
        "text": "4 The Rating Official must also: a Provide a copy of the completed rating and any supporting documentation to the servicing Human Resources Office (HRO) for processing and maintenance; and b Retain a copy of the completed rating and any supporting documentation for the Rating Official’s supervisory file.",
        "keyword": "must",
        "mandatory": true,
    },
    {
        "id": "dr4040_430-req-046",
        "section": "5",
