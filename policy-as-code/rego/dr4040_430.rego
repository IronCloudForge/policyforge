        "mandatory": true,
    },
    {
        "id": "dr4040_430-req-048",
        "section": "5",
        "section_title": "Performance Management",
        "text": "supervisor of record must make a reasonable effort to obtain appraisal information from the outside organization.",
        "keyword": "must",
        "mandatory": true,
    },
    {
        "id": "dr4040_430-req-049",
        "section": "5",
        "section_title": "Performance Management",
        "text": "c A rating of record recommended by the external organization must be approved by the respective employee’s Rating and Reviewing Officials of record. The final rating of record must be documented on the Form AD-435E or Form AD-435S and filed in the employee’s performance file (EPF).",
        "keyword": "must",
        "mandatory": true,
    },
    {
        "id": "dr4040_430-req-050",
        "section": "5",
        "section_title": "Performance Management",
        "text": "The final rating of record must be documented on the Form AD-435E or Form AD-435S and filed in the employee’s performance file (EPF).",
        "keyword": "must",
        "mandatory": true,
    },
    {
        "id": "dr4040_430-req-051",
        "section": "5",
        "section_title": "Performance Management",
        "text": "appropriate authority that the rating of record must be changed or produced or as part of a bona fide settlement of a formal proceeding; or c Where the Mission Area’s CHCO Council Member determines that a rating of record was incorrectly recorded or calculated.",
