        "keyword": "must",
        "mandatory": true,
    },
    {
        "id": "dr4040_430-req-047",
        "section": "5",
        "section_title": "Performance Management",
        "text": "to return to duty before October 30, the rating of record must be prepared and issued to the employee before the leave begins.",
