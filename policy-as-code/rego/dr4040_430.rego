        "keyword": "must",
        "mandatory": true,
    },
    {
        "id": "dr4040_430-req-038",
        "section": "5",
        "section_title": "Performance Management",
        "text": "a In this case, the Reviewing Official must sign as the Rating Official, and the Reviewing Official’s manager must sign as the Reviewing Official.",
        "keyword": "must",
        "mandatory": true,
    },
