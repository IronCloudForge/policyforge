        "mandatory": true,
    },
    {
        "id": "dr4040_430-req-011",
        "section": "5",
        "section_title": "Performance Management",
        "text": "(i) Performance measures must be prorated when the appraisal period is less than 1 year.",
        "keyword": "must",
        "mandatory": true,
    },
