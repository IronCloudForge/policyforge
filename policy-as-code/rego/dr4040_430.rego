    },
    {
        "id": "dr4040_430-req-003",
        "section": "5",
        "section_title": "Performance Management",
        "text": "The Reviewing Official must be in the Rating Official’s chain of command.",
        "keyword": "must",
        "mandatory": true,
    },
    {
        "id": "dr4040_430-req-004",
        "section": "5",
        "section_title": "Performance Management",
        "text": "(a) Performance elements must reflect the responsibilities and duties actually assigned to and expected to be performed by the employee, consistent with an accurate and current position description.",
        "keyword": "must",
        "mandatory": true,
    },
    {
        "id": "dr4040_430-req-005",
        "section": "5",
        "section_title": "Performance Management",
