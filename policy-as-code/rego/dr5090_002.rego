requirements := [
    {
        "id": "dr5090_002-req-001",
        "section": "1",
        "section_title": "Content",
        "text": "agencies shall establish goals that meet or exceed the Government-wide or Department-wide minimums. A decline in an agency's fiscal year goals from an average of the previous two years shall not be less than 5 percent.",
        "keyword": "shall",
        "mandatory": true,
    },
    {
        "id": "dr5090_002-req-002",
        "section": "1",
        "section_title": "Content",
        "text": "previous two years shall not be less than 5 percent.",
        "keyword": "shall",
        "mandatory": true,
    },
    {
        "id": "dr5090_002-req-003",
        "section": "1",
        "section_title": "Content",
        "text": "The HCA or a representative of the HCA shall designate in writing a small business coordinator in each contracting office. Supervisors of small business coordinators are encouraged to provide sufficient time for coordinators to carry out their small business program duties.",
        "keyword": "shall",
        "mandatory": true,
    },
    {
        "id": "dr5090_002-req-004",
        "section": "1",
        "section_title": "Content",
        "text": "shall be developed and submitted to OSDBU by the Cognizant HCAs of the Farm Service Agency and Agricultural Marketing Service.) (3) Provide quarterly assessments to serviced agenc",
        "keyword": "shall",
        "mandatory": true,
    },
    {
        "id": "dr5090_002-req-005",
        "section": "1",
        "section_title": "Content",
        "text": "Goals shall be submitted to the Director, OSDBU in both written and electronic forms.",
        "keyword": "shall",
        "mandatory": true,
    },
    {
        "id": "dr5090_002-req-006",
        "section": "1",
        "section_title": "Content",
        "text": "B to this regulation, HCA's and Agency Heads shall submit to the Director, OSDBU, the following data no later than August 15th each fiscal year: a an estimate of the total dollar amount of all prime contracts regardless of dollar value to be awarded during the fiscal year, including awards",
        "keyword": "shall",
        "mandatory": true,
    },
    {
        "id": "dr5090_002-req-007",
        "section": "1",
        "section_title": "Content",
        "text": "The Administrator of the Small Business Administration shall, within 30 days of receipt of the agency goals, respond to each agency expressing agreement or indicating reasons for disagreement. If interagency consultation fails to resolve differences, such cases of disagreement shall be submitted by the Administrator of the Small Business Administration to the Administrator of the Office of Federal Procurement Policy for final determination.",
        "keyword": "shall",
        "mandatory": true,
    },
    {
        "id": "dr5090_002-req-008",
        "section": "1",
        "section_title": "Content",
        "text": "disagreement shall be submitted by the Administrator of the Small Business Administration to the Administrator of the Office of Federal Procurement Policy for final determination.",
        "keyword": "shall",
        "mandatory": true,
    },
    {
        "id": "dr5090_002-req-009",
        "section": "1",
        "section_title": "Content",
        "text": "The head of each Federal agency having procurement powers shall report to the Administrator of the Small Business Administration on the extent of achievements against the goals established in paragraphs 7b through 7i. With the exception of subcontract goals, agency reports of goal achievements shall be based upon official SF- 279/SF281 data as recorded at",
        "keyword": "shall",
        "mandatory": true,
    },
    {
        "id": "dr5090_002-req-010",
        "section": "1",
        "section_title": "Content",
        "text": "subcontract goals, agency reports of goal achievements shall be based upon official SF- 279/SF281 data as recorded at the Federal Procurement Data Center. Agency reports of goal achievements in subcontracting shall be based upon official SF-295 data. These reports shall be submitted to the Small Business Administration no later than April 30th of the ye",
        "keyword": "shall",
        "mandatory": true,
    },
    {
        "id": "dr5090_002-req-011",
        "section": "1",
        "section_title": "Content",
