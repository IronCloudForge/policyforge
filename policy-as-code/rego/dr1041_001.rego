    },
    {
        "id": "dr1041_001-req-048",
        "section": "1",
        "section_title": "Content",
        "text": "Letters of invitation shall be prepared by the agency for the signature of the Secretary, and shall include: (1) Purpose, objectives, and expected accomplishments of the committee; (2) Name of the chairperson",
