        "section": "1",
        "section_title": "Content",
        "text": "The determination shall be accompanied by an explanation of the reasons why the meeting should be closed. The determination and accompanying explanation shall be forwarded to the CMO, through OGC and OP, at least 45 days before the scheduled meeting.",
        "keyword": "shall",
        "mandatory": true,
