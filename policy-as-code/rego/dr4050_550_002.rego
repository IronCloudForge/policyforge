# =============================================================================
# POLICY SECTIONS
# Excerpt of each section (first 500 chars). Full text: USDA_POLICY_SOURCE_FILES_TXT/
# =============================================================================

sections := {
        "1": {
            "title": "Purpose",
            "excerpt": "The purpose of this directive is to set forth the Department of Agriculture’s (USDA) policy\n     on Compensatory Time Off for Travel.",
        },
        "2": {
            "title": "References",
            "excerpt": "This directive must be used in conjunction with:\n\n     a.    Public Law 108-411, Section 203(a), Federal Workforce Flexibility Act of 2004,\n           October 30, 2004, Title 5, United States Code, section 5550b (5 U.S.C. 5550b); and\n\n     b.    Title 5, Code of Federal Regulations, part 550, Subpart N, Compensatory Time Off for\n           Travel, (5 CFR part 550, subpart N).\n DR 4050-550-002                                                            June 20, 2008",
        },
        "3": {
            "title": "Special Instructions",
            "excerpt": "This directive implements a new USDA policy for selected issues related to Compensatory\n   Time Off for Travel. The Federal Workforce Flexibility Act of 2004 established a new form\n   of compensatory time off for time spent by an employee in travel status away from the\n   employee’s official duty station when such time is not otherwise compensable.",
        },
        "4": {
            "title": "Policy",
            "excerpt": "It is USDA’s policy to authorize and approve compensatory time off for travel in accordance\n   with the above referenced law and regulation and with the procedures set forth in this\n   directive. Whenever possible, an employee’s travel should be scheduled within regular\n   working hours.",
        },
        "5": {
            "title": "Delegations Of Authority",
            "excerpt": "The authority to make determinations concerning compensatory time off for travel presently\n   resides with the Assistant Secretary for Administration (ASA) and the Director, Office of\n   Human Capital Management (OHCM). The authority is hereby delegated to Agency and\n   Staff Office Heads, as defined below, to administer the program within their respective\n   organizations. Agency and Staff Office Heads are encouraged to re-delegate the authority to\n   approve compensatory time off for travel to...",
        },
        "6": {
            "title": "Definitions",
            "excerpt": "a.   Agency. An organizational unit of the Department, other than a Staff Office as defined\n        below, whose head reports to an Under Secretary.\n\n   b.   Agency Head.         The head of a USDA Agency or an official who has been\n        delegated the authority to act for the head of the Agency in the matter concerned.\n\n   c.   Compensable. Time that is creditable as hours of work for the purpose of determining\n        pay entitlement, even when that work time may not actually generate additi...",
        },
        "7": {
            "title": "Responsibilities",
            "excerpt": "a.   The Director, OHCM, is responsible for:\n\n        (1)   Establishing USDA’s Compensatory Time Off for Travel policy and providing\n              technical assistance and advice on issues that arise;\n\n        (2)   Monitoring compliance with Departmental policy; and\n\n        (3)   Reporting to the Office of Personnel Management (OPM), as required.\n\n\n   b.   Agency and Staff Office Heads are responsible for:\n\n\n\n                                                3\n DR 4050-550-002...",
        },
        "8": {
            "title": "Applicability",
            "excerpt": "This directive is applicable to all USDA employees as defined in 5 U.S.C. 5541(2) without\n   regard to whether the employee is exempt from or covered by the overtime pay provisions of\n   the Fair Labor Standards Act of 1938, as amended. This includes employees in senior-level;\n   scientific or professional; and prevailing rate (wage) positions. It excludes members of the\n   Senior Executive Service and Senior Foreign Service or Foreign Service Officers.",
        },
        "9": {
            "title": "Creditable Travel Time",
            "excerpt": "a.   General. Subject to the conditions specified in this directive, Agency and Staff Office\n        Heads must credit an employee with compensatory time off for travel for time in travel\n        status if:\n\n        (1)   The employee is required to travel away from his or her official duty station for\n              work related purposes; and\n\n        (2)   The travel time is not otherwise compensable hours of work under other legal\n              authorities.\n\n   b.   Travel Status.\n\n        (1)...",
        },
        "10": {
            "title": "Crediting Compensatory Time Off For Travel",
            "excerpt": "a.   Employees must file requests in accordance with their Agency/Staff Office procedures\n        within six pay periods of the ending date of travel or their requests may be denied. The\n        date this request is made will not affect the time limit on forfeiture of unused\n        compensatory time off for travel discussed in Section 12 of this directive.\n\n   b.   If an employee files a request in accordance with the conditions set forth in this\n        directive and the procedures established...",
        },
        "11": {
            "title": "Usage Of Accrued Compensatory Time Off For Travel",
            "excerpt": "a.   An employee must request approval from his or her supervisor to schedule the use of\n        his or her accrued compensatory time off for travel in accordance with procedures\n        established by the Agency/Staff Office Head.\n\n   b.   Compensatory time off may be used when the employee is granted time off from his or\n        her scheduled tour of duty established for leave purposes.\n\n   c.   An employee must use earned compensatory time off for travel in increments of one-\n        quarter...",
        },
        "12": {
            "title": "Forfeiture Of Unused Compensatory Time Off For Travel",
            "excerpt": "a.   If an employee fails to use the compensatory time off for travel within 26 pay periods\n        after it was accrued, he or she must forfeit the compensatory time off for travel.\n\n   b.   Except as provided in (1) and (2) below, when an employee separates from Federal\n        Service, any unused compensatory time off for travel is forfeited. An employee who\n        separates or is placed in a leave without pay status in the following circumstances and\n        later returns to service with US...",
        },
        "13": {
            "title": "Prohibition Against Payment For Unused Compensatory Time Off",
            "excerpt": "FOR TRAVEL\n\n   As provided by 5 U.S.C. 5550b, an individual may not receive payment under any\n   circumstances for any unused compensatory time off for travel he or she earned under this\n   directive. This prohibition against payment applies to surviving beneficiaries in the event of\n   the individual’s death.",
        },
        "14": {
            "title": "Inapplicability Of Premium Pay And Aggregate Pay Caps",
            "excerpt": "Accrued compensatory time off for travel under this directive is not considered in applying\n   the premium pay limitations established under 5 U.S.C. 5547 and 5 CFR 550.105 through\n   550.107 or the aggregate limitation on pay established under 5 U.S.C. 5307 and 5 CFR part\n   530, subpart B.\n\n\n\n\n                                                8",
        }
}

# =============================================================================
# MANDATORY REQUIREMENTS
# Extracted from SHALL / MUST / REQUIRED language in the directive text.
# =============================================================================

requirements := [
    {
        "id": "dr4050_550_002-req-001",
        "section": "2",
        "section_title": "References",
        "text": "This directive must be used in conjunction with: a.",
        "keyword": "must",
        "mandatory": true,
    },
    {
        "id": "dr4050_550_002-req-002",
        "section": "9",
        "section_title": "Creditable Travel Time",
        "text": "Heads must credit an employee with compensatory time off for travel for time in travel status if: (1) The employee is required to travel away from his or her official duty station for work related purposes; and (2) The travel time is not otherwise compensable hours of work under other legal authorities.",
        "keyword": "must",
        "mandatory": true,
    },
    {
        "id": "dr4050_550_002-req-003",
        "section": "9",
        "section_title": "Creditable Travel Time",
        "text": "(1) The employee is required to travel away from his or her official duty station for work related purposes; and (2) The travel time is not otherwise compensable hours of work under other legal authorities.",
        "keyword": "required",
        "mandatory": true,
    },
    {
        "id": "dr4050_550_002-req-004",
        "section": "9",
        "section_title": "Creditable Travel Time",
        "text": "the point of first departure must be used to determine how many hours the employee actually spent in travel status for the purpose of accruing compensatory time off.",
        "keyword": "must",
        "mandatory": true,
    },
    {
        "id": "dr4050_550_002-req-005",
        "section": "9",
        "section_title": "Creditable Travel Time",
        "text": "(1) If an employee is required to travel directly between his or her home and a temporary duty station outside the limits of the employee’s official duty station, the travel time is creditable as time in travel status if otherwise qualifying under this section. However, Agency",
        "keyword": "required",
        "mandatory": true,
    },
    {
        "id": "dr4050_550_002-req-006",
        "section": "9",
        "section_title": "Creditable Travel Time",
        "text": "However, Agency and Staff Office Heads must deduct from such travel hours the time the employee would have spent in normal home-to-work or work-to-home commuting.",
        "keyword": "must",
        "mandatory": true,
    },
    {
        "id": "dr4050_550_002-req-007",
        "section": "9",
        "section_title": "Creditable Travel Time",
        "text": "Agency and Staff Office Head must determine the estimated amount of time in travel status the employee would have had if the employee had used the mode of transportation offered by the Agency and Staff Office Heads or traveled at the time or by the route selected by the Agency and Staff",
        "keyword": "must",
        "mandatory": true,
    },
    {
        "id": "dr4050_550_002-req-008",
        "section": "9",
        "section_title": "Creditable Travel Time",
        "text": "employee must be credited with the lesser of the estimated time in travel status or the actual time in travel status.",
        "keyword": "must",
        "mandatory": true,
    },
    {
        "id": "dr4050_550_002-req-009",
        "section": "9",
        "section_title": "Creditable Travel Time",
        "text": "(1) If an employee is required to travel between home and a transportation terminal located within the limits of his or her official duty station as part of travel away from that duty station, the travel time outside regular working hours to or from the terminal is considered to be equivalent to commuting time and is not creditable time in travel status.",
        "keyword": "required",
        "mandatory": true,
    },
    {
        "id": "dr4050_550_002-req-010",
        "section": "10",
        "section_title": "Crediting Compensatory Time Off For Travel",
        "text": "Employees must file requests in accordance with their Agency/Staff Office procedures within six pay periods of the ending date of travel or their requests may be denied. The date this request is made will not affect the time limit on forfeiture of unused compensatory time off for travel discussed in Section 12 of this directive.",
        "keyword": "must",
        "mandatory": true,
    },
    {
        "id": "dr4050_550_002-req-011",
        "section": "10",
        "section_title": "Crediting Compensatory Time Off For Travel",
        "text": "Agency/Staff Office Heads must track compensatory time off for travel under this directive separately from other forms of compensatory time off.",
        "keyword": "must",
        "mandatory": true,
    },
    {
        "id": "dr4050_550_002-req-012",
        "section": "11",
        "section_title": "Usage Of Accrued Compensatory Time Off For Travel",
        "text": "An employee must request approval from his or her supervisor to schedule the use of his or her accrued compensatory time off for travel in accordance with procedures established by the Agency/Staff Office Head.",
        "keyword": "must",
        "mandatory": true,
    },
    {
        "id": "dr4050_550_002-req-013",
        "section": "11",
        "section_title": "Usage Of Accrued Compensatory Time Off For Travel",
        "text": "An employee must use earned compensatory time off for travel in increments of one- quarter of an hour (15 minutes).",
        "keyword": "must",
        "mandatory": true,
    },
    {
        "id": "dr4050_550_002-req-014",
        "section": "11",
        "section_title": "Usage Of Accrued Compensatory Time Off For Travel",
        "text": "Compensatory time off for travel must be charged in the chronological order in which it was earned. Supervisors should take all necessary steps to avoid situations that might result in an employee accumulating compensatory time that cannot be used within the period specified in Section 14 below.",
        "keyword": "must",
        "mandatory": true,
    },
    {
        "id": "dr4050_550_002-req-015",
        "section": "11",
        "section_title": "Usage Of Accrued Compensatory Time Off For Travel",
        "text": "Compensatory time must be used by an employee before he or she may use annual leave, provided this shall not result in the employee losing any accumulated annual leave.",
        "keyword": "must",
        "mandatory": true,
    },
    {
        "id": "dr4050_550_002-req-016",
        "section": "11",
        "section_title": "Usage Of Accrued Compensatory Time Off For Travel",
        "text": "leave, provided this shall not result in the employee losing any accumulated annual leave.",
        "keyword": "shall",
        "mandatory": true,
    },
    {
        "id": "dr4050_550_002-req-017",
        "section": "11",
        "section_title": "Usage Of Accrued Compensatory Time Off For Travel",
        "text": "Except as provided in Section 12, an employee must use compensatory time off for travel by the end of the 26th pay period after the pay period during which it was accrued.",
        "keyword": "must",
        "mandatory": true,
    },
    {
        "id": "dr4050_550_002-req-018",
        "section": "12",
        "section_title": "Forfeiture Of Unused Compensatory Time Off For Travel",
        "text": "after it was accrued, he or she must forfeit the compensatory time off for travel.",
        "keyword": "must",
        "mandatory": true,
    },
    {
        "id": "dr4050_550_002-req-019",
        "section": "12",
        "section_title": "Forfeiture Of Unused Compensatory Time Off For Travel",
        "text": "Leave held in abeyance for the above reasons must be used by the end of the 26th pay period following the pay period in which the employee returns to duty, or such compensatory time off for travel will be forfeited.",
        "keyword": "must",
        "mandatory": true,
    },
    {
        "id": "dr4050_550_002-req-020",
        "section": "12",
        "section_title": "Forfeiture Of Unused Compensatory Time Off For Travel",
        "text": "outside USDA, he or she must forfeit his or her unused compensatory time off for travel.",
        "keyword": "must",
        "mandatory": true,
    },
    {
        "id": "dr4050_550_002-req-021",
        "section": "12",
        "section_title": "Forfeiture Of Unused Compensatory Time Off For Travel",
        "text": "Extension must be documented, in writing, and approved before the earned compensatory time period expires. Compensatory time off for travel not used in this 26 pay period extension will be forfeited.",
        "keyword": "must",
        "mandatory": true,
    }
]

# =============================================================================
# COMPLIANCE EVALUATION
# Input schema:
#   input.organization.agency   string   e.g. "USDA"
#   input.organization.office   string   e.g. "OCIO"
#   input.assertions            object   requirement_id -> bool
# =============================================================================

default compliant := false

compliant if {
    count(violations) == 0
}

violations contains violation if {
    some req in requirements
    req.mandatory == true
    not input.assertions[req.id]
    violation := {
        "id":           req.id,
        "directive":    directive.label,
        "section":      req.section_title,
        "requirement":  req.text,
        "keyword":      req.keyword,
        "nist_families": directive.nist_families,
    }
}

# =============================================================================
# APPLICABILITY
# =============================================================================

# All USDA departmental directives apply department-wide by default.
directive_applies if {
    input.organization.agency == "USDA"
}

# =============================================================================
# HELPERS
# =============================================================================

# NIST SP 800-53 Rev5 control families covered by this directive
nist_coverage := directive.nist_families

# Total number of extracted mandatory requirements
requirement_count := count(requirements)

# Set of all section titles in this directive
section_titles contains title if {
    some _, sec in sections
    title := sec.title
}

# Set of all requirement IDs for cross-referencing
requirement_ids contains id if {
    some req in requirements
    id := req.id
}

# Summary object for use in cross-directive index queries
summary := {
    "label":             directive.label,
    "title":             directive.title,
    "directive_type":    directive.directive_type,
    "effective_date":    directive.effective_date,
    "opi":               directive.opi,
    "nist_families":     directive.nist_families,
    "requirement_count": requirement_count,
    "section_count":     count(sections),
}
