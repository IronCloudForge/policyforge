    },
    {
        "id": "dr1044_7-req-011",
        "section": "1",
        "section_title": "Content",
        "text": "annual report, shall be provided jointly by the Administrators of the Agricultural Research Service and the Food and Nutrition Service, and by the heads of such other participating USDA agencies as may be appropriate.",
        "keyword": "shall",
        "mandatory": true,
