        "mandatory": true,
    },
    {
        "id": "dr1044_7-req-003",
        "section": "1",
        "section_title": "Content",
        "text": "shall also serve as members of the Council. In the event of successor positions or organizations, the equivalent officials shall serve as members of the Council.",
