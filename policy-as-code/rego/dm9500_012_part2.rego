        "section": "5",
        "section_title": "Technical Assistance",
        "text": "NRCS shall conduct periodic reviews of the easements and rental contracts to determine the success of restoration plans.",
        "keyword": "shall",
        "mandatory": true,
    },
    {
        "id": "dm9500_012-req-102",
        "section": "6",
        "section_title": "Restoration Requirements",
        "text": "A restoration plan shall be developed and will include both vegetative and structural practices (as needed) as well as management requirements needed to improve and maintain grassland and shrubland resources. A timeline for implementation of these practices will be included. Restoration activities will begin",
        "keyword": "shall",
        "mandatory": true,
