        "section": "6",
        "section_title": "Restoration Requirements",
        "text": "Sites must be capable of restoration to a self-sustaining level. Adverse off-site or on-site conditions that preclude successful restoration may render the site ineligible for GRP.",
        "keyword": "must",
        "mandatory": true,
    },
    {
        "id": "dm9500_012-req-104",
